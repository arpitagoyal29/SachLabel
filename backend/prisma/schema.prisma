// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IngredientStatus {
  SAFE
  BANNED
  SCHEDULE_H
  EU_BANNED
}

enum Severity{
  LOW
  MEDIUM
  HIGH
}

model Ingredient {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  status      IngredientStatus @default(SAFE)
  reason      String?
  source      String?
  createdAt   DateTime         @default(now())
  combinationsA CombinationRule[] @relation("CombinationA")
  combinationsB CombinationRule[] @relation("CombinationB")

}

model CombinationRule {
  id            Int      @id @default(autoincrement())
  ingredientAId Int
  ingredientBId Int
  severity      Severity
  reason        String
  source        String?
  createdAt     DateTime @default(now())
  ingredientA Ingredient @relation("CombinationA", fields: [ingredientAId], references: [id])
  ingredientB Ingredient @relation("CombinationB", fields: [ingredientBId], references: [id])
  @@unique([ingredientAId, ingredientBId])
}