# Frontend environment variables (Vite)
#
# Only variables prefixed with VITE_ are exposed to client code, via
# import.meta.env.VITE_*. They are INLINED AT BUILD TIME (`vite build`),
# not read at runtime — so on a host like Render, set these as BUILD-time
# environment variables, not runtime ones.
#
# Copy this file to `.env` for local overrides (`.env` is gitignored).

# Base URL of the deployed backend API (no trailing slash).
# Leave UNSET in local development — the Vite dev proxy (vite.config.js)
# forwards /api to http://localhost:3000, so relative paths just work.
# In production, set this to the deployed backend origin, e.g.:
#   VITE_API_URL=https://sachlabel-backend.onrender.com
VITE_API_URL=
